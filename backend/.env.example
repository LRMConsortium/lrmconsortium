# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ── Database (two C4 servers, Ghana) ───────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/lrmconsortium
MONGO_MAX_POOL_SIZE=25

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Pepper for the Founder Authorisation Code. HMAC-ed into the code before
# bcrypt, so a leaked database cannot be cracked without this value.
# REQUIRED in production — the process refuses to boot without it.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing FAC generation.
FAC_PEPPER=change-me-generate-a-real-one-with-the-command-above

# ── Multi-domain CORS ──────────────────────────────────────────────────────
# HQ (.africa) / Public (.com) / PR (africalrmc.com) / Ususu (africaususu.com)
CORS_ORIGINS=https://lrmconsortium.africa,https://lrmconsortium.com,https://africalrmc.com,https://africaususu.com,http://localhost:3000

# ── Ad engine ──────────────────────────────────────────────────────────────
AD_DEFAULT_SLOT_COUNT=3
AD_IMPRESSION_DEDUPE_WINDOW_SECONDS=30

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
