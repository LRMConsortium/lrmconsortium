# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
# Must match the upstream in frontend/deploy/nginx.conf.
PORT=4000
API_PREFIX=/api/v1

# ── Which market this deployment serves ────────────────────────────────────
# The US pilot and the Gambia launch are two deployments of one code line:
# separate databases, separate domains, separate .env files. Nothing is
# multi-tenant, which is what keeps "money is never summed across currencies"
# true by construction and keeps one jurisdiction's data out of the other's.
#
#   gambia        The Gambia · Banjul · GMD · +220 · 10% rent, 15% fare
#   unitedStates  United States · Casper, WY · USD · +1 · 10% rent, 18% fare
#
# Both are decided and deployable. A market whose terms are unset — no city, no
# fee — refuses a production boot naming each missing field, so a third market
# cannot be half-added and shipped.
#
# Development defaults to gambia. **Production refuses to boot without an
# explicit value**, because a silent default is how the pilot's configuration
# reaches Banjul and quotes every Gambian tenant in dollars.
LRMC_MARKET=gambia

# ── Database ───────────────────────────────────────────────────────────────
# NOT settled. This is a single local mongod. Pointed at two application
# servers it is two separate databases, each holding half the tenancies and
# neither aware of the other — and no replica set means no transactions, which
# several of the concurrency fixes want. Decide the topology before deploying.
MONGO_URI=mongodb://127.0.0.1:27017/lrmconsortium
MONGO_MAX_POOL_SIZE=25

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=12h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Pepper for the Founder Authorisation Code. HMAC-ed into the code before
# bcrypt, so a leaked database cannot be cracked without this value.
# REQUIRED in production — the process refuses to boot without it.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every existing FAC generation.
FAC_PEPPER=change-me-generate-a-real-one-with-the-command-above

# ── Multi-domain CORS ──────────────────────────────────────────────────────
# HQ (.africa) / Public (.com) / PR (africalrmc.com) / Ususu (africaususu.com)
CORS_ORIGINS=https://lrmconsortium.africa,https://lrmconsortium.com,https://africalrmc.com,https://africaususu.com,http://localhost:4000

# ── Ad engine ──────────────────────────────────────────────────────────────
AD_DEFAULT_SLOT_COUNT=3
AD_IMPRESSION_DEDUPE_WINDOW_SECONDS=30

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
